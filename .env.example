# X / Twitter (developer.twitter.com, klucze OAuth 1.0a z uprawnieniem Read+Write)
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Facebook Page (developers.facebook.com, token strony z uprawnieniem pages_manage_posts)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (konto Business/Creator powiazane ze strona FB powyzej)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok (developers.tiktok.com, Content Posting API)
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY dopoki apka nie przejdzie audytu TikTok; potem np. PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
